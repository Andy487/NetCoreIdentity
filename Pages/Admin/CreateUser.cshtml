@page
@model NetCoreIdentity.Pages.Admin.CreateUserModel

@{
    ViewData["Title"] = "Create User";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3>Create User</h3>
        </div>

        <div class="card-body">

            <form method="post">

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="UserVM.FullName" class="form-label"></label>
                    <input asp-for="UserVM.FullName" class="form-control" />
                    <span asp-validation-for="UserVM.FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UserVM.Email" class="form-label"></label>
                    <input asp-for="UserVM.Email" class="form-control" />
                    <span asp-validation-for="UserVM.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UserVM.Password" class="form-label"></label>
                    <input asp-for="UserVM.Password" class="form-control" />
                    <span asp-validation-for="UserVM.Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UserVM.Role" class="form-label"></label>

                    <select asp-for="UserVM.Role"
                            asp-items="Model.Roles"
                            class="form-select">

                        <option value="">-- Select Role --</option>

                    </select>

                    <span asp-validation-for="UserVM.Role" class="text-danger"></span>

                </div>

                <button type="submit" class="btn btn-success">
                    Create User
                </button>

                <a asp-page="/Admin/Users"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}